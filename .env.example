# Copy to .env for local runs. Without GEMINI_API_KEY the plan text is written by the built-in rules.
GEMINI_API_KEY=
# Models tried in order; a rejected or failed reply moves on to the next one.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000
PORT=8080
# Plans per client per minute, and for the whole server per minute (caps Gemini spend).
RATE_LIMIT_PER_MINUTE=8
GLOBAL_PLANS_PER_MINUTE=60
# Number of reverse proxies that append to X-Forwarded-For (Vercel: 1). Leave 0 when exposed directly.
TRUSTED_PROXIES=0
